<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>arcade</id>
	<name>Arcade</name>
	<summary>Play retro games from your files</summary>
	<description><![CDATA[Play retro console games straight from your NextCloud files.

Arcade runs the RetroArch libretro cores in the browser, so nothing is uploaded anywhere else. It comes with a games library with box art, save states, screenshots, SRAM and BIOS handling, touch controls, and configurable keys — all kept in folders of your own choosing.]]></description>
	<version>0.29.0</version>
	<licence>agpl</licence>
	<author homepage="https://robloach.net">Rob Loach</author>
	<namespace>Arcade</namespace>
	<!--
		remote.php loads only apps of these types, and every upload goes
		through it. Without this the app is not booted while a ROM is being
		written, its mimetypes are never registered, and the file is stored
		as application/octet-stream, which the Viewer has no player for.
	-->
	<types>
		<filesystem/>
	</types>
	<category>games</category>
	<bugs>https://github.com/robloach/nextcloud-arcade</bugs>
	<repository type="git">https://github.com/robloach/nextcloud-arcade.git</repository>
	<screenshot small-thumbnail="https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/img/screenshot-thumbnail.jpg">https://raw.githubusercontent.com/robloach/nextcloud-arcade/master/img/screenshot.png</screenshot>
	<dependencies>
		<php min-version="8.3"/>
		<nextcloud min-version="34" max-version="35"/>
	</dependencies>
	<repair-steps>
		<post-migration>
			<step>OCA\Arcade\Migration\RegisterMimeTypes</step>
			<step>OCA\Arcade\Migration\RegisterMetadata</step>
		</post-migration>
		<install>
			<step>OCA\Arcade\Migration\RegisterMimeTypes</step>
			<step>OCA\Arcade\Migration\RegisterMetadata</step>
		</install>
		<uninstall>
			<step>OCA\Arcade\Migration\UninstallCleanup</step>
		</uninstall>
	</repair-steps>
	<commands>
		<command>OCA\Arcade\Command\Cleanup</command>
		<command>OCA\Arcade\Command\Uninstall</command>
	</commands>
	<settings>
		<admin>OCA\Arcade\Settings\Admin</admin>
		<admin-section>OCA\Arcade\Settings\AdminSection</admin-section>
		<personal>OCA\Arcade\Settings\Personal</personal>
		<personal-section>OCA\Arcade\Settings\PersonalSection</personal-section>
	</settings>
	<navigations>
		<navigation>
			<id>arcade</id>
			<name>Arcade</name>
			<route>arcade.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
