<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nostalgist</id>
	<name>Nostalgist</name>
	<summary>Nostalgist for NextCloud</summary>
	<description>Play retro games directly in NextCloud.</description>
	<version>0.16.0</version>
	<licence>agpl</licence>
	<author homepage="https://robloach.net">Rob Loach</author>
	<namespace>Nostalgist</namespace>
	<category>games</category>
	<bugs>https://github.com/robloach/nextcloud-nostalgist</bugs>
	<repository type="git">https://github.com/robloach/nextcloud-nostalgist.git</repository>
	<screenshot small-thumbnail="https://raw.githubusercontent.com/robloach/nextcloud-nostalgist/master/img/screenshot-thumbnail.jpg">https://raw.githubusercontent.com/robloach/nextcloud-nostalgist/master/img/screenshot.png</screenshot>
	<dependencies>
		<nextcloud min-version="29" max-version="35"/>
	</dependencies>
	<repair-steps>
		<post-migration>
			<step>OCA\Nostalgist\Migration\RegisterMimeTypes</step>
		</post-migration>
		<install>
			<step>OCA\Nostalgist\Migration\RegisterMimeTypes</step>
		</install>
	</repair-steps>
	<commands>
		<command>OCA\Nostalgist\Command\Cleanup</command>
	</commands>
	<settings>
		<admin>OCA\Nostalgist\Settings\Admin</admin>
		<admin-section>OCA\Nostalgist\Settings\AdminSection</admin-section>
		<personal>OCA\Nostalgist\Settings\Personal</personal>
		<personal-section>OCA\Nostalgist\Settings\PersonalSection</personal-section>
	</settings>
	<navigations>
		<navigation>
			<id>nostalgist</id>
			<name>Nostalgist</name>
			<route>nostalgist.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
