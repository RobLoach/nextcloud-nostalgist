{
  "name": "@robloach/nextcloud-arcade",
  "version": "0.36.0",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.js --progress",
    "cores": "mkdir -p img/cores && for core in fceumm snes9x gambatte mgba genesis_plus_gx picodrive mednafen_pce_fast handy mednafen_ngp mednafen_wswan mednafen_vb vecx gearcoleco; do unzip -o -q \"3rdparty/retroarch-emscripten-build/retroarch/${core}_libretro.zip\" -d img/cores; done",
    "dev": "NODE_ENV=development webpack --config webpack.js --progress",
    "l10n": "node build/extract-l10n.mjs",
    "postcores": "cp 3rdparty/retroarch-emscripten-build/license img/cores/license",
    "precores": "git submodule update --init --recursive",
    "test": "npm run build",
    "watch": "NODE_ENV=development webpack --config webpack.js --progress --watch"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "devDependencies": {
    "@nextcloud/auth": "^2.5.2",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/files": "^3.12.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "nostalgist": "0.22.0"
  },
  "allowScripts": {
    "@nextcloud/webpack-vue-config@7.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "vue-demi@0.14.10": true,
    "core-js@3.50.0": true
  },
  "dependencies": {
    "@nextcloud/dialogs": "^5.3.8",
    "fflate": "^0.8.3"
  }
}
